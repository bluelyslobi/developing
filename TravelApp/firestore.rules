rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 헬퍼 ──────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    // ── users ───────────────────────────────────────────────
    // 본인 프로필만 쓰기 가능, 읽기는 로그인 필요
    match /users/{uid} {
      allow read: if isLoggedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ── posts ────────────────────────────────────────────────
    // 읽기: 누구나 / 작성: 로그인 / 수정·삭제: 본인만
    match /posts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn()
        && (
          // 본인 글 수정
          resource.data.uid == request.auth.uid
          ||
          // 좋아요(likes, likedBy), 댓글 수(comments) 카운트 업데이트만 허용
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy', 'comments']))
        );
      allow delete: if isOwner(resource.data.uid);

      // comments 서브컬렉션
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid);
        allow update: if false;
      }
    }

    // ── products ─────────────────────────────────────────────
    // 읽기: 누구나 / 작성: 로그인 / 수정·삭제: 본인만
    match /products/{productId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid);
      allow delete: if isOwner(resource.data.uid);
    }

    // ── packages ─────────────────────────────────────────────
    // 읽기: 누구나 / 작성: 로그인 / 수정·삭제: 본인만
    match /packages/{packageId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid)
        ||
        // 리뷰 등록 시 rating/reviews 카운트 업데이트 허용
        (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviews']));
      allow delete: if isOwner(resource.data.uid);

      // reviews 서브컬렉션
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isLoggedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid);
        allow update: if false;
      }
    }

    // ── chats ─────────────────────────────────────────────────
    // 채팅 참여자만 읽기/쓰기 가능
    match /chats/{chatId} {
      allow read: if isLoggedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isLoggedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isLoggedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // messages 서브컬렉션
      // chats/{chatId} 문서가 아직 없을 때(첫 메시지 전송 전)도 실시간 리스너가
      // permission-denied로 죽지 않도록, 부모 문서 부재 시에는 허용(빈 목록)한다.
      match /messages/{messageId} {
        allow read: if isLoggedIn()
          && (
            !exists(/databases/$(database)/documents/chats/$(chatId))
            || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );
        allow create: if isLoggedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── reservations ──────────────────────────────────────────
    // 본인 예약만 읽기/쓰기
    match /reservations/{reservationId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────
    // 신고는 로그인 필요, 읽기는 본인 신고만
    match /reports/{reportId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}
